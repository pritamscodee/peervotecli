{
  "name": "pearpass-private-election",
  "version": "1.0.0",
  "type": "module",
  "description": "PeerVote CLI — anonymous zero-knowledge yes/no voting from the terminal on Midnight. A hashed nullifier is the only public trace per vote.",
  "author": "PearPass",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/private-election.compact contracts/managed/private-election",
    "build": "npx tsc --noEmit || true",
    "setup": "npx tsx src/setup.ts",
    "deploy": "npx tsx src/deploy.ts",
    "cli": "npx tsx src/cli.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "node scripts/clean.mjs",
    "test": "node --import tsx --test tests/keys.test.ts",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "election:demo": "tsx scripts/private-election-demo.ts",
    "db:init": "tsx scripts/db-init.ts",
    "audit:store": "tsx scripts/audit-store.ts",
    "web": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "web:preview": "vite preview --config vite.config.ts",
    "web:static": "tsx src/web-server.ts",
    "api": "tsx src/server.ts",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@scure/bip39": "2.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnightntwrk/dapp-connector-api": "^4.1.0-beta.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vite": "^8.3.1",
    "vite-plugin-wasm": "^3.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy",
    "voting",
    "pearpass"
  ]
}
